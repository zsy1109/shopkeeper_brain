# ============================================================
# 掌柜智库 环境变量配置模板
# 复制此文件为 .env，填入你的实际配置
# ============================================================

# ==================== LLM 配置（必须） ====================
# OpenAI 兼容 API 地址（任何符合 OpenAI 协议的模型服务都行）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 默认问答模型
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_TEMPERATURE=0.3

# 视觉模型（图片总结用）
VL_MODEL=gpt-4o-mini

# 商品名识别专用模型（可以和默认模型相同）
ITEM_MODEL=gpt-4o-mini

# 知识图谱相关模型（可选）
KG_MODEL=gpt-4o-mini

# ==================== BGE Embedding 模型 ====================
# bge-m3 模型本地路径（绝对路径或相对于项目根目录）
BGE_M3_PATH=models/BAAI--bge-m3
# 推理设备：cuda:0 / cpu
BGE_DEVICE=cuda:0
# 是否开启 FP16 加速
BGE_FP16=true

# ==================== BGE Reranker 模型 ====================
# bge-reranker-large 模型本地路径
BGE_RERANKER_LARGE=models/BAAI--bge-reranker-large
# 推理设备（可以和 Embedding 不同 GPU）
BGE_RERANKER_DEVICE=cuda:0
# 是否开启 FP16 加速
BGE_RERANKER_FP16=true

# ==================== Embedding 参数 ====================
# 向量维度（bge-m3 是 1024）
EMBEDDING_DIM=1024
# Embedding 模型名称（用于 Milvus collection schema）
EMBEDDING_MODEL=bge-m3

# ==================== Milvus 配置（必须） ====================
# Milvus 连接地址（本地开发可用 Milvus Lite，生产用 Standalone/Cluster）
MILVUS_URL=http://localhost:19530
# 文档切片集合名
CHUNKS_COLLECTION=knowledge_chunks
# 商品名集合名
ITEM_NAME_COLLECTION=item_names
# 实体名集合名（可选）
ENTITY_NAME_COLLECTION=entity_names

# 向量检索参数
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.5

# ==================== MongoDB 配置（必须） ====================
# 对话历史存储
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=shopkeeper_brain

# ==================== MinIO 配置（必须） ====================
# 文档对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=shopkeeper-brain

# ==================== MCP / DashScope 配置（可选） ====================
# Agent 模式下联网搜索用
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ==================== 检索 / 重排调优（可选，有默认值） ====================
# Rerank 节点：top_k 裁剪
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.5

# RRF 融合排序
RRF_K=60
RRF_MAX_RESULTS=10

# 召回数量
EMBEDDING_SEARCH_LIMIT=5
HYDE_SEARCH_LIMIT=5

# 上下文拼接最大字符数
MAX_CONTEXT_CHARS=12000

# ==================== 商品名识别调优（可选） ====================
ITEM_NAME_HIGH_CONFIDENCE=0.75
ITEM_NAME_MID_CONFIDENCE=0.45
ITEM_NAME_SCORE_GAP=0.08
ITEM_NAME_MAX_OPTIONS=3
ITEM_NAME_DENSE_WEIGHT=0.5
ITEM_NAME_SPARSE_WEIGHT=0.5

# ==================== Agent 模式（可选） ====================
# 是否启用 Agent 模式（ReAct + Tool Calling），默认 false
ENABLE_AGENT_MODE=false
AGENT_MAX_TURNS=5